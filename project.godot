; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Torque & Tombs"
config/description="Top-down vehicular action roguelite in trap-laden tombs."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerData="*res://scripts/autoload/PlayerData.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
ComboTracker="*res://scripts/autoload/ComboTracker.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="PlayerProjectiles"
3d_physics/layer_5="EnemyProjectiles"
3d_physics/layer_6="Triggers"
3d_physics/layer_7="Breakables"

[rendering]

anti_aliasing/quality/msaa_3d=2
